# Axis Configuration Example
# Copy this to .env and fill in your values

# ============================================
# Source PostgreSQL Database
# ============================================
PG_DSN=postgresql://username:password@localhost:5432/source_database
PG_CHANNEL=axis_channel

# ============================================
# RabbitMQ Configuration
# ============================================
RMQ_URL=amqp://guest:guest@localhost:5672/
RMQ_EXCHANGE=axis_exchange

# ============================================
# Replication Settings
# ============================================
# Tables to replicate (comma-separated, use * for all)
TABLES_TO_REPLICATE=users,orders,products

# Batch processing settings
BATCH_SIZE=10
BATCH_TIMEOUT=5.0

# Queue settings
MAX_QUEUE_SIZE=10000
PREFETCH_COUNT=10

# ============================================
# State Persistence
# ============================================
STATE_FILE=./axis_state.json

# ============================================
# Example Replica Databases (for CLI --replicas)
# ============================================
# Pass these as command-line arguments:
# python src/cli.py --replicas \
#   "postgresql://user:pass@replica1:5432/db" \
#   "postgresql://user:pass@replica2:5432/db"
